# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
# .env содержит секреты — он уже в .gitignore, в git его коммитить не нужно.

# ───────────────────────── Telegram ─────────────────────────

# Токен бота от @BotFather: команда /newbot, затем скопировать токен целиком.
BOT_TOKEN=PASTE_YOUR_TOKEN_HERE

# Ваш Telegram ID — владелец бота, доступ у него есть всегда и не зависит от БД.
# Узнать ID: запустите бота без этой настройки и отправьте ему /start — он покажет ваш ID.
# Можно указать несколько через запятую: OWNER_ID=111111111,222222222
OWNER_ID=PASTE_YOUR_TELEGRAM_ID_HERE

# ───────────────────────── База данных ─────────────────────────

# PostgreSQL на вашем сервере. Формат: postgresql://пользователь:пароль@хост:порт/имя_базы
# Базу и пользователя нужно создать заранее, например:
#   sudo -u postgres createuser btc_bot -P
#   sudo -u postgres createdb btc_tracker -O btc_bot
# Миграции (таблицы) бот создаёт сам при первом запуске.
DATABASE_URL=postgresql://btc_bot:CHANGE_ME@localhost:5432/btc_tracker

# Размер пула соединений к БД (обычно менять не нужно).
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# require — принудительно требовать SSL; disable — принудительно отключить.
# Пусто (по умолчанию) — взять из DATABASE_URL как есть (для локальной БД на том же сервере не нужно).
# DB_SSL=

# Включите (true), если БД стоит за PgBouncer в режиме transaction pooling.
# DB_DISABLE_STATEMENT_CACHE=false

# ───────────────────────── Часовой пояс и расписание ─────────────────────────

# Часовой пояс для расписания сводок и отображения времени. В Беларуси круглый год UTC+3 (без перехода
# на летнее время), поэтому Europe/Minsk работает всегда, даже без установленного tzdata на сервере.
TZ_NAME=Europe/Minsk

# Во сколько присылать ежедневную сводку (курс BTC, USD, EUR, RUB). Время — по TZ_NAME, через запятую.
REPORT_TIMES=08:00,14:00,20:00,23:59

# Сколько минут после точного времени сводки ещё можно её отправить, если бот был недоступен
# (например, перезагружался сервер). Дольше этого — сводка за тот слот пропускается, а не шлётся часы спустя.
# REPORT_GRACE_MINUTES=15

# Кому слать сообщение с курсами сразу после запуска бота (включение/перезагрузка сервера, обновление):
#   all   — всем пользователям с доступом (по умолчанию)
#   owner — только владельцу(ям)
#   off   — не слать вовсе
# STARTUP_REPORT=all

# Не слать стартовое сообщение повторно, если бот перезапустился быстрее, чем за это число секунд —
# защита от спама при цикле падений/перезапусков (crash loop).
# STARTUP_MIN_GAP=180

# ───────────────────────── Опрос курсов ─────────────────────────

# Как часто опрашивать источники курсов, секунд.
# POLL_INTERVAL=60

# Таймаут запроса к одному источнику курса, секунд.
# HTTP_TIMEOUT=6

# HTTP(S)-прокси для запросов к API курсов, если нужен (напр. http://user:pass@host:port).
# API_PROXY=

# Прокси для соединения с Telegram API, если Telegram заблокирован на сервере.
# TELEGRAM_PROXY=

# ───────────────────────── Алерты и приглашения ─────────────────────────

# Срок жизни одноразовой ссылки-приглашения, часов.
# INVITE_TTL_HOURS=24

# Максимум активных алертов на одного пользователя.
# MAX_ALERTS_PER_USER=25

# ───────────────────────── Логи ─────────────────────────

# DEBUG | INFO | WARNING | ERROR
# LOG_LEVEL=INFO

# Путь к файлу лога (в дополнение к выводу в консоль/journalctl). Относительный путь — от корня проекта.
# LOG_FILE=logs/bot.log
